POSTGRES_USER=kairo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kairo
POSTGRES_PORT=5432

DATABASE_URL=postgresql://kairo:change-me@localhost:5432/kairo
TEST_DATABASE_URL=postgresql://kairo:change-me@localhost:5432/kairo
# DATABASE_SCHEMA=public

# Control-plane HTTP server. The API binds to loopback by default.
# HOST=127.0.0.1
# PORT=3000
# SESSION_TTL_SECONDS=604800
# LOG_LEVEL=info

# Native harness model providers. Leave a credential commented out unless that provider is
# used. API keys are read from the environment; they are never stored in agent or model config.
#
# Gemini uses GEMINI_API_KEY, or GOOGLE_API_KEY when only that variable is present.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# KAIRO_GEMINI_API_KEY_ENV=GEMINI_API_KEY
# KAIRO_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# KAIRO_GEMINI_TIMEOUT_SECONDS=30
#
# Claude uses ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# KAIRO_ANTHROPIC_API_KEY_ENV=ANTHROPIC_API_KEY
# KAIRO_ANTHROPIC_BASE_URL=https://api.anthropic.com
# KAIRO_ANTHROPIC_TIMEOUT_SECONDS=30
# KAIRO_ANTHROPIC_MAX_TOKENS=1024
#
# OpenAI uses OPENAI_API_KEY and optionally OPENAI_ORGANIZATION.
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# KAIRO_OPENAI_API_KEY_ENV=OPENAI_API_KEY
# KAIRO_OPENAI_BASE_URL=https://api.openai.com/v1
# KAIRO_OPENAI_TIMEOUT_SECONDS=30
#
# Ollama endpoint for the standalone harness smoke script. This must be reachable from the
# process running the harness, which may be a container rather than the host machine.
KAIRO_OLLAMA_BASE_URL=http://127.0.0.1:11434
KAIRO_OLLAMA_MODEL=gemma3:270m
# KAIRO_OLLAMA_TIMEOUT_SECONDS=30
