POSTGRES_USER=kairo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kairo
POSTGRES_PORT=5432

DATABASE_URL=postgresql://kairo:change-me@localhost:5432/kairo
TEST_DATABASE_URL=postgresql://kairo:change-me@localhost:5432/kairo
# DATABASE_SCHEMA=public

# Ollama endpoint for the standalone harness smoke script. This must be reachable from the
# process running the harness, which may be a container rather than the host machine.
KAIRO_OLLAMA_BASE_URL=http://127.0.0.1:11434
KAIRO_OLLAMA_MODEL=gemma3:270m
