{
  "name": "@kairo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "generate:types": "node scripts/generate-schema-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "json-schema-to-ts": "3.1.1"
  },
  "devDependencies": {
    "@kairo/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
