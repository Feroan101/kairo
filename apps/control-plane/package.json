{
  "name": "@kairo/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
